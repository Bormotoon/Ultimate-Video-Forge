@@ -217,16 +256,78 @@ def generate_fcpxml(
     video_clips = sorted((c for c in plan.clips if c.kind == "video"), key=lambda c: c.offset)
     audio_clips = sorted((c for c in plan.clips if c.kind != "video"), key=lambda c: c.offset)
 
