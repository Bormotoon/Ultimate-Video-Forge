+def test_scan_cameras_subfolders_become_separate_lanes(tmp_path, monkeypatch) -> None:  # noqa: ANN001
     monkeypatch.setattr("whispersync.engine.pipeline.probe", _fake_probe)
     (tmp_path / "camA").mkdir()
     (tmp_path / "camB").mkdir()
